# Optional: cp apps/web/.env.example apps/web/.env from the repository root.
# Only public browser configuration belongs here; never add server secrets.
# The API requires its own configuration in apps/api/.env.

# Leave empty for the local Vite /api proxy or a production same-origin proxy.
# For a separate API origin, use an exact URL without a trailing slash, e.g.
# VITE_API_URL=https://api.example.com
# The API's WEB_ORIGIN must match the frontend origin.
VITE_API_URL=
