{
  "name": "@lumolynk/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check-types && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy --env production",
    "cf:typegen": "wrangler types --env production",
    "cf:deploy:check": "pnpm build && wrangler deploy --dry-run",
    "check-types": "pnpm --filter @lumolynk/app routes:generate && tsc -b"
  },
  "dependencies": {
    "@lumolynk/app": "workspace:*",
    "@lumolynk/ui": "workspace:*",
    "@tanstack/react-router": "1.170.45",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@lumolynk/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
