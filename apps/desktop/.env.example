# Public configuration bundled into main; HTTPS required except local loopback.
MAIN_VITE_API_URL=http://localhost:3001
MAIN_VITE_WEB_ORIGIN=http://localhost:3000

# Optional runtime overrides for main only: DESKTOP_API_URL, DESKTOP_WEB_ORIGIN.
# Sessions persist only with an OS-protected safeStorage backend.

# Drive shares the web UI and uses authorized URLs for direct storage transfers.
# Configure S3 only on the API; never bundle AWS credentials in desktop variables.
# Bucket CORS must permit lumo://app (packaged) and your desktop development origin.
