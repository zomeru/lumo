{
  "name": "@lumolynk/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LumoLynk collaboration desktop application",
  "author": "LumoLynk",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm check-types && electron-vite build",
    "check-types": "pnpm --filter @lumolynk/app routes:generate && tsc --noEmit",
    "preview": "electron-vite preview",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "@lumolynk/app": "workspace:*",
    "@lumolynk/ui": "workspace:*",
    "@lumolynk/api-client": "workspace:*",
    "@lumolynk/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@tanstack/react-router": "1.170.44",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "electron-builder": "26.15.3",
    "tough-cookie": "6.0.2",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "com.lumolynk.desktop",
    "productName": "LumoLynk",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json",
      "resources/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "LumoLynk uses your camera when you enable video in a meeting.",
        "NSMicrophoneUsageDescription": "LumoLynk uses your microphone when you enable audio in a meeting."
      }
    },
    "executableName": "lumolynk"
  }
}
