{
  "name": "@lumo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=bundle --external:pg --external:better-auth --external:@better-auth/drizzle-adapter --external:drizzle-orm --external:nodemailer --external:pino --outfile=dist/index.mjs",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@lumo/auth": "workspace:*",
    "@lumo/contracts": "workspace:*",
    "@lumo/database": "workspace:*",
    "@lumo/env": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "drizzle-orm": "0.45.4",
    "pino": "10.4.0",
    "zod": "4.6.7",
    "@better-auth/drizzle-adapter": "1.7.10",
    "better-auth": "1.7.10",
    "nodemailer": "10.1.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@lumo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "vitest": "5.0.5"
  }
}
