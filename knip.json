{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": { "ignoreDependencies": ["@tanstack/intent"] },
    "packages/typescript-config": {},
    "apps/api": {
      "entry": ["src/test/e2e-server.ts", "src/test/live-provider.ts"],
      "project": ["src/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["@better-auth/drizzle-adapter", "better-auth"]
    },
    "packages/app": {
      "entry": ["src/routes/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "*.config.ts"]
    },
    "apps/desktop": {
      "project": ["src/**/*.{ts,tsx,css}", "*.config.ts"]
    }
  }
}
