{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": true,
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "VITE_*",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "NODE_ENV",
        "API_ORIGIN",
        "WEB_ORIGIN",
        "PORT",
        "HOST",
        "SMTP_URL",
        "MAIL_FROM",
        "MAIL_DIR",
        "LOG_LEVEL"
      ]
    },
    "@lumo/web#check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["node_modules/.tmp/*.tsbuildinfo", "src/routeTree.gen.ts"]
    }
  }
}
